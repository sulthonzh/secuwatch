{
  "name": "webperf",
  "version": "1.0.0",
  "description": "Zero-config CLI for web performance monitoring with Core Web Vitals and key metrics",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webperf": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "performance",
    "web",
    "monitoring",
    "cli",
    "web-vitals",
    "lighthouse",
    "devtools",
    "seo",
    "core-web-vitals",
    "lcp",
    "fid",
    "cls",
    "inp"
  ],
  "author": "Sulthon",
  "license": "MIT",
  "dependencies": {
    "puppeteer": "^21.0.0",
    "web-vitals": "^3.0.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/inquirer": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}